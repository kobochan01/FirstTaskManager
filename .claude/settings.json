{
  "permissions": {
    "allow": [
      "Bash(netstat *)",
      "Bash(docker ps *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose down *)",
      "Bash(docker-compose ps *)",
      "Bash(docker-compose *)",
      "Bash(taskkill *)",
      "Bash(npm run dev *)",
      "Bash(npm run dev)",
      "Bash(./mvnw spring-boot:run *)",
      "Bash(./mvnw spring-boot:run)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "& '.claude\\hooks\\test-runner.ps1'",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "テストを実行中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "& '.claude\\hooks\\danger-guard.ps1'",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "コマンドの安全性を確認中..."
          }
        ]
      }
    ]
  }
}
